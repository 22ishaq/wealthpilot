# Copy to .env for `npm run dev:api`. The app connects as the restricted role; migrations
# run as the schema owner.
DATABASE_URL=postgresql://wealthpilot_app:wealthpilot_app@localhost:5432/wealthpilot
MIGRATION_DATABASE_URL=postgresql://wealthpilot:wealthpilot@localhost:5432/wealthpilot
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
